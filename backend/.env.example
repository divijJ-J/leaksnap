# Copy these into Render's Environment Variables tab when you deploy.
# render.yaml auto-generates ADMIN_TOKEN for you — copy it from the Render dashboard after deploy.

ADMIN_TOKEN=changeme-copy-from-render-dashboard
RESEND_API_KEY=
FROM_EMAIL=LeakSnap <noreply@yourdomain.com>
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW=60
